   "source": [
    "import sys; sys.path.insert(0, '../backend')\n",
    "import matplotlib.pyplot as plt\n",
    "from app.services.data_store import load\n",
    "batting = load('batting')\n",
    "if not batting.empty and 'season' in batting.columns:\n",
    "    s = batting.groupby('season')['runs'].sum()\n",
    "    s.plot(kind='bar', title='Runs per season'); plt.tight_layout(); plt.show()\n"
   ]
  }
